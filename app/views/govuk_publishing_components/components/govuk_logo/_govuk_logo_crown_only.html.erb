<%
  classes ||= %w[govuk-header__logotype]
%>

<svg
  focusable="false"
  class="<%= classes.join(" ") %>"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  height="30"
  width="32"
  viewBox="0 0 32 30">
  <%= render "govuk_publishing_components/components/govuk_logo/uh_crown_image", crown_width: 32, crown_height: 30 %>
</svg>
