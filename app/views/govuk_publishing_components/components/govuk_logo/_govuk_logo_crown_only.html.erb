<%
  classes ||= %w[govuk-header__logotype]
%>
<%# Crown-only version of the same published UH site-identity asset used by GOV.UH.
    It is decorative; the containing control must retain its accessible name. %>
<span
  class="<%= classes.join(" ") %>"
  aria-hidden="true"
  style="display: inline-block; width: 32px; height: 30px; background-color: currentColor; -webkit-mask: url('https://www.gov.uhrblx.com/uh-brand/uh-crown-black-20261014.png') center / contain no-repeat; mask: url('https://www.gov.uhrblx.com/uh-brand/uh-crown-black-20261014.png') center / contain no-repeat;"></span>
