<%# Render the published UH crown, not the inherited UK Royal crown paths.
    The image URL is the existing UH site-identity asset, not a new emblem.
    Review the image-origin/CSP and institutional identity before production release. %>
<span
  class="govuk-header__logotype"
  role="img"
  aria-label="GOV.UH"
  style="display: inline-flex; align-items: center; gap: 7px; min-height: 30px; color: inherit; vertical-align: middle;">
  <span
    aria-hidden="true"
    style="display: inline-block; width: 33px; height: 30px; flex: 0 0 33px; background-color: currentColor; -webkit-mask: url('https://www.gov.uhrblx.com/uh-brand/uh-crown-black-20261014.png') center / contain no-repeat; mask: url('https://www.gov.uhrblx.com/uh-brand/uh-crown-black-20261014.png') center / contain no-repeat;"></span>
  <span
    aria-hidden="true"
    style="font-size: 27px; font-weight: 700; line-height: 30px; letter-spacing: -0.8px; white-space: nowrap;">GOV.UH</span>
</span>
